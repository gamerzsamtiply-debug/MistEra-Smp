    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test:api": "node tests/api.test.mjs",
    "test": "npm run test:api && npm run test:markdown && npm run test:seo && npm run test:seo-render",
    "test:markdown": "node tests/markdown.test.mjs",
    "ci": "npm run typecheck && npm test && npm run build",
    "assets:localize": "node scripts/localize-assets.mjs",
    "test:seo": "node tests/seo.test.mjs",
    "test:seo-render": "node tests/seo-render.test.mjs"
  },
