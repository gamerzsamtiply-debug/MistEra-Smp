# ───────────────────────── Frontend (public — safe to expose) ─────────────────────────
# Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The "anon" / "publishable" key. This key is public by design; all data access is
# blocked by Row Level Security and goes through the server API instead.
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# ───────────────────────── Server (SECRET — never prefix with VITE_) ─────────────────────────
# Same project URL (optional; falls back to VITE_SUPABASE_URL)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# "service_role" key. Full database access. Set it ONLY in Vercel / your local .env.local.
# Never commit it and never expose it in frontend code.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-SECRET
# Email of the owner/admin account. It keeps full admin access and is shown as "Admin" on the Staff page.
OWNER_EMAIL=gamerzsamtiply@gmail.com
# STRONGLY RECOMMENDED (sign-up needs no e-mail confirmation): lock the owner account to ONE exact Supabase auth user.
# Supabase Dashboard -> Authentication -> Users -> copy the "User UID" of the owner account.
# When set, the Owner role needs BOTH the verified OWNER_EMAIL and this user id.
OWNER_USER_ID=
